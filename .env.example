# DRAGON RIFAT AI BOT - example environment variables.
# The engine itself reads NO environment variables: your application reads these
# and passes them to the bot / providers. Copy to .env and never commit it.

# Optional Telegram notifications (TelegramNotificationProvider)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Credentials for an AUTHORIZED execution adapter built from
# src/execution/adapters/OfficialApiAdapterTemplate.js (only if the platform offers an official API)
BROKER_API_BASE_URL=
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_ACCOUNT_ID=

# Real-money execution stays off unless you pass allowLiveTrading: true in code.
